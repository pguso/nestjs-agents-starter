# openai | anthropic | ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini

# Required when AI_PROVIDER=openai get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Used when AI_PROVIDER=ollama (no API key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional
# PORT=3000
