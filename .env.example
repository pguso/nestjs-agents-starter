# openai | anthropic | ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini

# Required when AI_PROVIDER=openai — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Used when AI_PROVIDER=ollama (no cloud API key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional override for the OpenAI-compatible client (default: ollama)
# OLLAMA_API_KEY=ollama

# Identity: dev = spoofable x-user-id header; jwt = require Bearer token
AUTH_MODE=dev

# Comma-separated browser origins. Unset = allow all in non-production; locked in production.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional
# PORT=3000
# NODE_ENV=development
