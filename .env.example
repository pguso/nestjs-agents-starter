# =============================================================================
# NOT FOR PRODUCTION — copy to .env for local/demo only.
#
# Auth: AUTH_MODE=dev spoofs x-user-id; jwt-stub is unsigned Bearer.
#       Production requires AUTH_MODE=jwt + JWT_SECRET (boot refuses stubs).
# Store: default conversation store is in-memory (lost on restart; not multi-instance).
#       Swap InMemoryConversationStore for Postgres/Redis before shipping.
# =============================================================================

# openai | anthropic | ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini

# Required when AI_PROVIDER=openai - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Used when AI_PROVIDER=ollama (no cloud API key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional override for the OpenAI-compatible client (default: ollama)
# OLLAMA_API_KEY=ollama

# Identity:
#   dev       = spoofable x-user-id (default; local only)
#   jwt-stub  = unsigned Bearer sub (local/demo only)
#   jwt       = verified HS256 Bearer (requires JWT_SECRET)
# Boot refuses AUTH_MODE=dev and jwt-stub when NODE_ENV=production.
AUTH_MODE=dev

# Required when AUTH_MODE=jwt (HS256). Optional issuer/audience checks:
# JWT_SECRET=
# JWT_ISSUER=
# JWT_AUDIENCE=

# Comma-separated browser origins. Unset = allow all in non-production; locked in production.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional JSON/urlencoded body limit (default 256kb)
# BODY_SIZE_LIMIT=256kb

# Global rate limit (POST /chat uses a tighter 20/min override)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=60

# Log agent step usage / finish events as JSON lines (true|1|yes|on)
# AGENT_METRICS_LOG=true

# Optional
# PORT=3000
# NODE_ENV=development
